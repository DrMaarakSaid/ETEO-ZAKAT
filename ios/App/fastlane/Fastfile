default_platform(:ios)

platform :ios do
  desc "Build and sign the app"
  lane :build do
    setup_ci if ENV['CI']
    
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: false
    )

    # On construit l'URL avec le token DEDANS (contourne le bug de Fastlane)
    repo_url = "https://DrMaarakSaid:#{ENV['GITHUB_PAT_FOR_MATCH']}@github.com/DrMaarakSaid/eteo-certificats.git"

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      git_url: repo_url
    )
    
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./build"
    )
  end
end